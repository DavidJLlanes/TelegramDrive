{
  "name": "telegram-drive",
  "version": "1.0.0",
  "description": "Unidad de almacenamiento personal sobre Telegram (PWA): carpetas, reproductor de música y vídeo, lightbox y descargas.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "David Jiménez Llanes",
  "engines": {
    "node": ">=20"
  },
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "setup": "node scripts/setup.js",
    "login": "node scripts/login.js",
    "icons": "node scripts/generate-icons.js",
    "check": "node scripts/check.js",
    "test": "node --test test/api.test.js test/sync.test.js",
    "dev:fake": "node test/helpers/dev-fake-server.js"
  },
  "dependencies": {
    "big-integer": "^1.6.52",
    "busboy": "^1.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mime-types": "^2.1.35",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "sharp": "^0.35.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
