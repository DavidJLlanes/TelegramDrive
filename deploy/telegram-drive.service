[Unit]
Description=Telegram Drive (PWA + API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/djl.com.es/telegram
ExecStart=/usr/bin/node server/index.js
Environment=NODE_ENV=production
Environment=NODE_NO_WARNINGS=1
# yt-dlp y SpotDL viven en venvs dentro de data/tools (antes estaba en un drop-in fuera del repositorio).
# El HOME escribible de SpotDL lo fija la propia app (server/features/music-downloads/spotdl-env.js).
Environment=PATH=/var/www/djl.com.es/telegram/data/tools/yt-dlp-venv/bin:/var/www/djl.com.es/telegram/data/tools/spotdl-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Restart=always
RestartSec=5
# Límites de recursos (incluyen a yt-dlp, SpotDL y FFmpeg, que cuelgan del mismo servicio).
# Ajusta a la RAM de tu VPS: MemoryHigh frena antes de MemoryMax, que mata el servicio si se supera.
MemoryHigh=1536M
MemoryMax=2560M
TasksMax=512
# Endurecimiento
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/djl.com.es/telegram/data
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
