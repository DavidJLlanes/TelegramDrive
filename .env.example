# --- Telegram (https://my.telegram.org -> API development tools) ---
TG_API_ID=
TG_API_HASH=
# Chat donde se guardan los archivos. "me" = Mensajes guardados.
# Para un grupo o canal privado: su ID numérico (ver "npm run chats"), p. ej. -1001234567890.
TG_CHAT=me

# --- Servidor ---
PORT=3100
HOST=127.0.0.1
# Prefijo bajo el que Nginx publica la app (sin barra final salvo "/")
BASE_PATH=/telegram
DATA_DIR=data

# --- Acceso web (los rellena `npm run setup`) ---
APP_PASSWORD_HASH=
SESSION_SECRET=
SESSION_DAYS=30

# --- Subidas ---
# 2000 para cuentas normales, 4000 para Telegram Premium
MAX_UPLOAD_MB=2000

# Segundo factor opcional (TOTP). Genera el secreto con: npm run totp
# APP_TOTP_SECRET=

# Aviso opcional si Telegram deja de responder (POST de texto plano; p. ej. un tema de ntfy.sh)
# HEALTH_WEBHOOK_URL=
# También recibe los avisos de seguridad (dispositivo nuevo, intentos fallidos repetidos).

# --- Registro de accesos ---
# ACCESS_LOG_DAYS=90
# ACCESS_FAIL_ALERT=5          # intentos fallidos desde una IP en 10 min que disparan un aviso

# --- Copia de seguridad cifrada (enlaces compartidos, registro de accesos, ajustes) ---
# Se envía cifrada (AES-256-GCM) a un chat de Telegram y se conservan las últimas BACKUP_KEEP.
# BACKUP_ENABLED=true
# BACKUP_PASSPHRASE=             # 12+ caracteres. SIN ELLA NO SE PUEDE RESTAURAR: guárdala en tu gestor de contraseñas
# BACKUP_CHAT=me                 # "me" = Mensajes guardados, o el ID de otro grupo (npm run chats)
# BACKUP_EVERY_HOURS=24
# BACKUP_KEEP=7
# BACKUP_INCLUDE_SESSION=false   # true incluye la sesión de Telegram (da acceso a tu cuenta si alguien tiene copia y frase)

# --- Fotos ---
# PHOTOS_SCAN_MINUTES=10         # cada cuánto se buscan fotos JPEG nuevas para leer su fecha/ubicación EXIF
