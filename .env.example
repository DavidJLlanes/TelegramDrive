# --- Telegram (https://my.telegram.org -> API development tools) ---
TG_API_ID=
TG_API_HASH=
# Chat donde se guardan los archivos. "me" = Mensajes guardados.
TG_CHAT=me

# --- Servidor ---
PORT=3100
HOST=127.0.0.1
# Prefijo bajo el que Nginx publica la app (sin barra final salvo "/")
BASE_PATH=/telegram
DATA_DIR=data

# --- Acceso web (los rellena `npm run setup`) ---
APP_PASSWORD_HASH=
SESSION_SECRET=
SESSION_DAYS=30

# --- Subidas ---
# 2000 para cuentas normales, 4000 para Telegram Premium
MAX_UPLOAD_MB=2000
